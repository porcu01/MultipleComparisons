  }
}

box_stack(list(
  expression(bold("No normality: ") * F[j] * " any continuous distribution"),
  expression(bold("Same shape: ") * F[j] * " differ only in location"),
  expression(bold("Independence: ") * Y[ji] * " mutually independent")))
```

\vspace{-1.3em}

\settowidth{\hangindent}{$\textcolor{crukdark}{\bullet}$ \colorbox{cruklight}{\color{white}Hypotheses}: }\hangafter=1 $\textcolor{crukdark}{\bullet}$ \colorbox{cruklight}{\color{white}Hypotheses}: $H_{j\ell} : F_j = F_\ell$, $1 \leq j < \ell \leq k$\vspace{1.5pt}\newline {\fontsize{10.5pt}{12.5pt}\selectfont For each of the $n = k(k-1)/2$ pairs, the two group distributions are equal

\par

}

\vspace{0.25em}

\setlength{\abovedisplayskip}{2pt}\setlength{\belowdisplayskip}{2pt}$\textcolor{crukdark}{\bullet}$ \textbf{Test statistic} for each pair, from the \textbf{mean ranks} $\bar{R}_j$ over all $N$ observations: $$t_{j\ell} = \frac{\bar{R}_j - \bar{R}_\ell}{\sqrt{\frac{N(N+1)}{12}\left(1/m_j + 1/m_\ell\right)}}
\qquad\text{asymptotically } N(0,1) \text{ under } H_{j\ell}$$

\settowidth{\hangindent}{$\textcolor{crukdark}{\bullet}$ }\hangafter=1 $\textcolor{crukdark}{\bullet}$ \textbf{$p$-value} of each pair: $p_{j\ell} = 2\left(1 - \Phi(|t_{j\ell}|)\right)$; \textbf{Bonferroni} or \textbf{Holm} is then applied to these $n$ $p$-values. $\mathcal{D}$ is \textbf{ignored}

\par

## Simulations and practicals

\vspace{1em}

\textbf{Shiny web application}

\small\url{https://bioinformatics.cruk.cam.ac.uk/stats/shinystats/}\normalsize

\vspace{2em}

\textbf{Exercises}

\small\url{http://bioinformatics-core-shared-training.github.io/IntroductionToStats/practical.html}\normalsize

## FWER and statistical power: the Achilles' heel {.t}

\vspace{-0.05em}

For each gene, expression was simulated in a control and a treatment group ($5$ units each), drawn from a normal distribution ($\mu = 0$, $\sigma = 1$). For a fraction of genes (10% and 50%), an effect size $\mathrm{ES} = 2$ ($\sim$ 79% power, $\alpha = 0.05$) was simulated by setting $\mu = 2$ in the treatment sample

\vspace{-0.6em}

\begin{center}
\includegraphics[width=\textwidth,height=0.53\textheight,keepaspectratio]{FWER and statistical power.png}
\end{center}

\vspace{-1.0em}

Genes were assumed to be statistically independent.

\begin{tikzpicture}[remember picture, overlay]
\node[anchor=south west, inner sep=0, font=\tiny] at ([xshift=10pt,yshift=11pt]current page.south west) {Krzywinski, M. \& Altman, N. \textit{Comparing samples --- part II}. Nature Methods \textbf{11}(4), 355--356 (April 2014).};
\end{tikzpicture}

## FWER and statistical power: the Achilles' heel {.t}

\vspace{-0.05em}

\begingroup\centering

\textbf{\% of truly differentially expressed genes declared significant}

\par
\endgroup

\vspace{-1.1em}

```{r fwer-power-table, results="asis"}
## Results come from the cached, seeded simulation in fwer-power-simulation.R;
## the script re-runs only if the CSV is missing.
if (!file.exists("fwer-power-simulation.csv")) source("fwer-power-simulation.R")
pw <- read.csv("fwer-power-simulation.csv", check.names = FALSE)

fmt <- function(x) formatC(100 * x, format = "f", digits = 2)

cat("\\begin{center}\n\\small\n\\begin{tabular}{r|ccc|ccc}\n\\hline\n")
cat("& \\multicolumn{3}{c|}{\\textcolor{crukdark}{10\\% affected}}",
    "& \\multicolumn{3}{c}{\\textcolor{crukdark}{50\\% affected}} \\\\\n")
cat("$n$ & Bonf. & Holm & \\v{S}id\\'ak &",
    "Bonf. & Holm & \\v{S}id\\'ak \\\\\n\\hline\n")
for (N in sort(unique(pw$N))) {
  a <- pw[pw$N == N & pw$frac == 0.1, ]
  b <- pw[pw$N == N & pw$frac == 0.5, ]
  cat(formatC(N, format = "d", big.mark = ","), "&",
      paste(fmt(c(a$Bonferroni, a$Holm, a$Sidak,
                  b$Bonferroni, b$Holm, b$Sidak)), collapse = " & "),
      "\\\\\n")
}
cat("\\hline\n\\end{tabular}\\par\\vspace{3pt}\n{\\footnotesize Legend: $n$ = number of genes; Bonf.\\ = Bonferroni correction; $10^5$ simulated trials per $n$\\par}\n\\normalsize\n\\end{center}\n")
```

\vspace{0.2em}

\settowidth{\hangindent}{$\textcolor{crukdark}{\bullet}$ }\hangafter=1 $\textcolor{crukdark}{\bullet}$ Power collapses as the family grows: with $n = 10$, about $\textcolor{crukdark}{35\%}$ of the truly affected genes are detected; with $n = 100{,}000$, only $\textcolor{crukdark}{0.02\%}$

\settowidth{\hangindent}{$\textcolor{crukdark}{\bullet}$ }\hangafter=1 $\textcolor{crukdark}{\bullet}$ All three corrections give essentially the same power. The step-wise gain (Holm) is visible only for small $n$ with many true effects

## False discovery rate (FDR) {.t}

\vspace{-6pt}

Let $\mathcal{F} = \{H_1, H_2, \dots, H_n\}$ be a finite family of null hypotheses, and let $m_0$ ($0 \le m_0 \le n$) denote the number of \colorbox{red}{\color{black}TRUE} \textbf{null hypotheses}.

\vspace{-0.4em}

\begin{center}
\normalsize
\begin{tabular}{lccc}
\hline
$\mathcal{F}$ & Not Rejected & Rejected & Total \\
\hline
\colorbox{red}{\color{black}TRUE}  & \color{crukdark}$U$ & \colorbox{crukpink}{\color{crukdark}$V$} & $m_0$ \\
\colorbox{green}{\color{black}FALSE} & \color{crukdark}$T$ & \color{crukdark}$S$ & $n - m_0$ \\
\hline
Total & \color{crukdark}$n - R$ & \colorbox{crukpink}{\color{crukdark}$R$} & $n$ \\
\hline
\end{tabular}
\end{center}
\begingroup
\setlength{\leftmargini}{0pt}

\hangindent=9pt\\hangafter=1 $\textcolor{crukdark}{\bullet}$ Consider the \textbf{proportion} of rejections that are false, $\textcolor{crukdark}{Q} = \textcolor{crukdark}{V} / \textcolor{crukdark}{R}$, with the convention $\textcolor{crukdark}{Q = 0}$ when \color{crukdark}$R = 0$\color{black}

\hangindent=9pt\\hangafter=1 $\textcolor{crukdark}{\bullet}$ $\textcolor{crukdark}{Q}$ is a random variable that cannot be observed: \color{crukdark}$R$ \color{black} is known once the tests are run, but \color{crukdark}$V$ \color{black} is not. We therefore control its \textbf{expectation}

\endgroup

\vspace{-0.3em}

\begin{center}
\textbf{\textcolor{crukdark}{\large FDR $\boldsymbol{:=}$ E$\left[\,\colorbox{crukpink}{$Q$}\,\right]$}}
\end{center}

\vspace{-0.7em}

\begingroup\centering\small

We accept that, \textbf{on average}, a controlled \textbf{proportion of our discoveries is false}.

\par\vspace{-\parskip}

\textbf{We tolerate some errors in exchange for more power.}

\par
\endgroup

## FWER and FDR as the number of tests grows

\vspace{0.5em}

\begingroup
\setlength{\leftmargini}{0pt}

\settowidth{\hangindent}{$\textcolor{crukdark}{\bullet}$ }\hangafter=1 $\textcolor{crukdark}{\bullet}$ Let $\mathcal{F} = \{H_1, H_2, \dots, H_n\}$ be a finite family of null hypotheses with \textbf{independent} test statistics, each tested at level $\alpha$

\settowidth{\hangindent}{$\textcolor{crukdark}{\bullet}$ }\hangafter=1 $\textcolor{crukdark}{\bullet}$ In both series $80\%$ of the nulls are \colorbox{red}{\color{black}TRUE} ($m_0 = 0.8\,n$, no effect); the other $20\%$ are \colorbox{green}{\color{black}FALSE}, each detected with an assumed \textbf{power} $\boldsymbol{= 90\%}$ at every $\alpha$

\begin{center}
\begin{tabular}{@{}l@{\hspace{2.2em}}l@{}}
$\textcolor{crukdark}{\bullet}$ \textbf{Filled}: FWER $= 1 - (1-\alpha)^{m_0}$ &
$\textcolor{crukdark}{\bullet}$ \textbf{Open}: FDR $= \mathrm{E}[V/R]$ \\[-0.1em]
\phantom{$\textcolor{crukdark}{\bullet}$ \textbf{Filled}: }{\small\textcolor{crukdark}{(a probability)}} &
\phantom{$\textcolor{crukdark}{\bullet}$ \textbf{Open}: }{\small\textcolor{crukdark}{(an expected proportion)}}
\end{tabular}
\end{center}

\vspace{-1.9em}

\endgroup

```{r fwer-plot-2, fig.width=6.2, fig.height=2.85, fig.align="center", out.width="84%"}
n      <- 0:100
alphas <- c(0.05, 0.01, 0.001)
cols   <- c("#FF0087", "#009CEE", "#00007E")
labs   <- c(expression(alpha == 0.05), expression(alpha == 0.01),
            expression(alpha == 0.001))

## FDR = E[V/R] when a fraction of the n hypotheses are false nulls, each
## detected with probability `power`: V ~ Binomial(m0, alpha) false positives
## and S ~ Binomial(m1, power) true discoveries, R = V + S, Q = 0 when R = 0.
fdr_curve <- function(n, alpha, frac_false = 0.2, power = 0.9) {
  vapply(n, function(nn) {
    m1 <- round(frac_false * nn)
    m0 <- nn - m1
    if (m0 == 0) return(0)
    v  <- 0:m0
    s  <- 0:m1
    q  <- outer(v, s, function(V, S) ifelse(V + S == 0, 0, V / (V + S)))
    sum(outer(dbinom(v, m0, alpha), dbinom(s, m1, power)) * q)
  }, numeric(1))
}

par(mar = c(2.6, 4.6, 0.6, 9.5), mgp = c(2.2, 0.5, 0), xpd = FALSE)
plot(NULL, xlim = c(0, 100), ylim = c(0, 1), bty = "n", las = 1, xaxt = "n",
     xaxs = "i", xlab = "",
     ylab = "Error rate", cex.axis = 0.9, cex.lab = 1.4)
axis(1, at = seq(0, 100, 20), cex.axis = 0.9)

abline(h = seq(0, 1, 0.25), col = "grey88", lwd = 0.8)

## one point estimate for every n = 0, 1, ..., 100, never joined up:
## m0 = n - round(0.2 n) true nulls and m1 = round(0.2 n) false nulls
m0v <- n - round(0.2 * n)
for (i in seq_along(alphas)) {
  points(n, 1 - (1 - alphas[i])^m0v, col = cols[i], pch = 19, cex = 0.34)
  points(n, fdr_curve(n, alphas[i]), col = cols[i], pch = 1, cex = 0.40,
         lwd = 0.9)
}

par(xpd = NA)
mtext(expression(italic(n)), side = 1, line = 0.5, at = 108, cex = 1.4, las = 1)

legend(x = 108, y = 0.68, legend = labs, col = cols, pch = 19, pt.cex = 1.0,
       bty = "n", cex = 1.2, text.col = "grey15",
       y.intersp = 1.5, xjust = 0, yjust = 0.5)

legend(x = 108, y = 0.13, legend = c("FWER", "FDR"), pch = c(19, 1),
       col = "grey35", pt.cex = c(0.9, 1.0), pt.lwd = 1.2, bty = "n",
       cex = 0.95, text.col = "grey15", y.intersp = 1.4, xjust = 0,
       yjust = 0.5)
```

## Three questions about the FDR {.t}

\vspace{1.2em}

\begingroup\setlength{\leftmargini}{0pt}

\Large

$\textcolor{crukdark}{\bullet}$ \textbf{How can we control the FDR?}

\vspace{1.2em}

$\textcolor{crukdark}{\bullet}$ \textbf{How can we estimate the FDR?}

\vspace{1.2em}

$\textcolor{crukdark}{\bullet}$ \textbf{How can we compute FDR-adjusted $\boldsymbol{p}$-values?}

\normalsize

\endgroup

## Uniform distribution of the $p$-value {.t}

\vspace{-0.01em}

\begingroup

Let the null hypothesis $H_0$ be \colorbox{red}{\color{black}TRUE}, and let the $p$-value be computed from the \textbf{continuous} null distribution of the \textbf{test statistic} $t$. The $p$-value ($p$) is itself a random variable such that $\boldsymbol{\color{crukdark}{p \sim \mathrm{Uniform}(0,1)}}$.

\par
\endgroup

\vspace{-0.1em}

```{r pvalue-uniform, fig.width=7.6, fig.height=2.4, fig.align="center"}
crukdark  <- "#00007E"
cruklight <- "#009CEE"

## Cached: the (seeded) null p-values are simulated once and stored in
## pvalue-uniform-null.rds; delete that file to re-simulate.
n_sim   <- 1e6
df      <- 8
rds_out <- "pvalue-uniform-null.rds"

if (file.exists(rds_out)) {
  p_null <- readRDS(rds_out)
} else {
  set.seed(7)
  p_null <- 2 * pt(-abs(rt(n_sim, df = df)), df = df)
  saveRDS(p_null, rds_out)
}

par(mfrow = c(1, 2), mar = c(3.4, 3.6, 1.6, 1.0), mgp = c(2.0, 0.6, 0))

hist(p_null, breaks = 25, freq = FALSE, col = cruklight, border = "white",
     main = expression(bold("Histogram of ") * bolditalic(p) * bold("-values under H0")), xlab = expression(italic(p) * "-value"), ylab = "Density",
     cex.main = 0.95, cex.lab = 0.9, cex.axis = 0.8)
abline(h = 1, col = crukdark, lwd = 2)

ps  <- sort(p_null)
idx <- round(seq(1, n_sim, length.out = 2000))
plot(ps[idx], idx / n_sim, type = "l", col = crukdark, lwd = 2.2,
     main = expression(bold("Empirical CDF of ") * bolditalic(p) * bold("-values")), xlab = expression(italic(p) * "-value"), ylab = "Cumulative probability",
     cex.main = 0.95, cex.lab = 0.9, cex.axis = 0.8, las = 1)
abline(0, 1, col = cruklight, lwd = 2, lty = 2)
```

\vspace{-1.7em}

\begingroup

Simulated $p$-values under $H_0$ ($\mu_1 = \mu_2$) from a two-sample $t$-test with $5$ units per group ($10^6$ simulations): the histogram is flat at density $1$ and the empirical cumulative distribution function (CDF) tracks the diagonal $y = x$, confirming $p \sim \mathrm{Uniform}(0,1)$.

\par
\endgroup

## Controlling the FDR: Benjamini--Hochberg (BH) {.t}

\vspace{-0.01em}

\settowidth{\hangindent}{$\textcolor{crukdark}{\bullet}$ \colorbox{cruklight}{\color{white}The question}: }\hangafter=1 $\textcolor{crukdark}{\bullet}$ \colorbox{cruklight}{\color{white}The question}: not \textit{``did I make \textbf{any} mistake?''} (FWER), but \textit{``what \textbf{share} of my list of discoveries is wrong?''}

\par

\vspace{0.3em}

\settowidth{\hangindent}{$\textcolor{crukdark}{\bullet}$ \colorbox{cruklight}{\color{white}Count}: }\hangafter=1 $\textcolor{crukdark}{\bullet}$ \colorbox{cruklight}{\color{white}Count}: reject every $p_i \leq \gamma$. Each \colorbox{red}{\color{black}TRUE} null is Uniform$(0,1)$, so it falls below $\gamma$ with probability $\gamma$: under $H_0^{\mathrm{global}}$ we expect about $n\,\gamma$ \textbf{false} discoveries, against the $k$ discoveries we \textbf{observe} ($k$ = their number = the rank of the last rejected $p$-value)

\par

\vspace{0.3em}

\settowidth{\hangindent}{$\textcolor{crukdark}{\bullet}$ \colorbox{cruklight}{\color{white}Rule}: }\hangafter=1 $\textcolor{crukdark}{\bullet}$ \colorbox{cruklight}{\color{white}Rule}: make that share equal to the FDR level $q$ we are willing to accept (plug-in for $\mathrm{FDR} = \mathbb{E}[V/R]$) \vspace{-0.2em} $$\frac{\text{expected false}}{\text{observed discoveries}} = \frac{n\,\gamma}{k} = q \qquad \Longrightarrow \qquad \textcolor{crukdark}{\boldsymbol{\gamma = \frac{k\,q}{n}}}$$

\vspace{-0.6em}

\settowidth{\hangindent}{$\textcolor{crukdark}{\bullet}$ \colorbox{cruklight}{\color{white}Choice}: }\hangafter=1 $\textcolor{crukdark}{\bullet}$ \colorbox{cruklight}{\color{white}Choice}: the threshold $\gamma$ depends on the rank $k$, and $k$ depends on $\gamma$: BH takes the \textbf{largest} $k$ that still satisfies the rule

\par

\vspace{0.2em}

\begingroup\centering

\textbf{\large BH turns the FDR level $\boldsymbol{q}$ into a rank-dependent threshold}

\par\endgroup
\begin{tikzpicture}[remember picture, overlay]
\node[anchor=south west, inner sep=0, text width=341pt, align=left, font=\scriptsize, text=gray] at ([xshift=10.7pt,yshift=12.5pt]current page.south west) {Benjamini, Y. \& Hochberg, Y. \textit{Controlling the false discovery rate: a practical and powerful approach to multiple testing}. J.\ R.\ Stat.\ Soc.\ B \textbf{57}(1), 289--300 (1995).};
\end{tikzpicture}

## Controlling the FDR: Benjamini--Hochberg (BH) {.t}

\vspace{-0.01em}

\begingroup

The $p$-values from $n = 1000$ \textbf{independent} tests are \textbf{ordered} and compared with the \textbf{increasing} threshold $i\,q/n$, to control the \textbf{FDR} at $q = 0.10$

\par
\endgroup

\vspace{-0.5em}

```{r bh-plot, fig.width=6.8, fig.height=2.6, fig.align="center", out.width="95%"}
crukdark  <- "#00007E"
cruklight <- "#009CEE"
crukpink  <- "#FF0087"

## same simulated data as the Storey slide: 800 true nulls + 200 real effects
set.seed(7)
n_bh  <- 1000
m0_bh <- 800
p_bh  <- c(runif(m0_bh), 2 * pnorm(-abs(rnorm(n_bh - m0_bh, mean = 3))))
q_bh  <- 0.10

ps <- sort(p_bh); ii <- seq_len(n_bh)
k_bh <- max(which(ps <= ii * q_bh / n_bh))      # largest i with p(i) <= i alpha/n
xmax <- 250

par(mar = c(3.0, 4.4, 0.6, 0.8), mgp = c(2.3, 0.6, 0))
plot(NULL, xlim = c(0, xmax), ylim = c(0, 0.032), bty = "n", las = 1,
     xlab = "", ylab = "", cex.axis = 0.95)
mtext(expression("rank " * italic(i) * " of the ordered " * italic(p) * "-values"),
      side = 1, line = 1.9, cex = 1.1)
mtext(expression(italic(p) * "-value"), side = 2, line = 3.0, cex = 1.1)

## the BH threshold: a straight line through the origin with slope alpha/n
abline(0, q_bh / n_bh, col = crukpink, lwd = 2.6)
text(xmax, xmax * q_bh / n_bh + 0.0028,
     expression(italic(i) * italic(q) / italic(n)), col = crukpink, cex = 1.15, font = 2,
     adj = c(1, 0.5), xpd = NA)

## the ordered p-values: rejected ones in dark blue, the rest in grey
sel <- 1:xmax
points(sel, ps[sel], pch = 19, cex = 0.5,
       col = ifelse(sel <= k_bh, crukdark, "grey65"))

## the cut: the LAST point that is still below the line
padj_bh <- sort(p.adjust(p_bh, "BH"))   # BH-adjusted p-values, ordered
segments(k_bh, 0, k_bh, ps[k_bh], col = crukdark, lwd = 1.4, lty = 2)
points(k_bh, ps[k_bh], pch = 21, bg = "white", col = crukdark, lwd = 2, cex = 1.2)

arrows(128, 0.0245, k_bh - 4, ps[k_bh] + 0.0013, length = 0.08,
       lwd = 2, col = crukdark)
text(72, 0.0315, bquote(italic(k) == .(k_bh)),
     col = crukdark, cex = 1.15, adj = c(0, 0.5), xpd = NA)
text(72, 0.0270, bquote("reject ranks 1 to" ~ italic(k)),
     col = crukpink, cex = 1.15, font = 3, adj = c(0, 0.5), xpd = NA)
```

\vspace{-1.5em}

\begingroup\centering\footnotesize
\renewcommand{\arraystretch}{1.0}
\begin{tabular}{cccc}
\hline
rank $i$ & $p_{(i)}$ & $i\,q/n$ & $\tilde{p}_{(i)}$ \\
\hline
$`r k_bh`$ \textbf{(=\,$\boldsymbol{k}$)} & $`r sprintf('%.6f', ps[k_bh])`$ & $`r sprintf('%.6f', k_bh*q_bh/n_bh)`$ & $\boldsymbol{`r sprintf('%.5f', padj_bh[k_bh])`}$ \\
$`r k_bh+1`$ \textbf{(=\,\textit{k+1})} & $`r sprintf('%.6f', ps[k_bh+1])`$ & $`r sprintf('%.6f', (k_bh+1)*q_bh/n_bh)`$ & $`r sprintf('%.5f', padj_bh[k_bh+1])`$ \\
\hline
\end{tabular}\par
\endgroup
\begin{tikzpicture}[remember picture, overlay]
\node[anchor=south, inner sep=0, font=\small\bfseries, text=crukdark] at ([yshift=12pt]current page.south) {The \textbf{adjusted} $p$-value $\boldsymbol{\tilde{p}_{(i)}}$: see the slide \textit{FDR-adjusted $p$-values: the $q$-value}};
\end{tikzpicture}

## Controlling the FDR: Benjamini--Hochberg (BH) {.t}

\vspace{-0.01em}

\settowidth{\hangindent}{$\textcolor{crukdark}{\bullet}$ }\hangafter=1 $\textcolor{crukdark}{\bullet}$ \colorbox{cruklight}{\color{white}Conservative}: the rule counts \textbf{every} hypothesis as a possible false discovery ($n\,\gamma$), but only the $m_0$ \colorbox{red}{\color{black}TRUE} nulls can produce one. The real level is therefore \vspace{-0.25em} $$\mathrm{FDR} \leq \frac{m_0}{n}\,q \leq q$$

\vspace{-0.55em}

\settowidth{\hangindent}{$\textcolor{crukdark}{\bullet}$ }\hangafter=1 $\textcolor{crukdark}{\bullet}$ The factor $m_0/n$ is \textbf{power given away}: Storey's $\hat{\pi}_0$ tries to recover it

\par

\vspace{0.45em}

\settowidth{\hangindent}{$\textcolor{crukdark}{\bullet}$ }\hangafter=1 $\textcolor{crukdark}{\bullet}$ \colorbox{cruklight}{\color{white}Without independence}: the proof needs each \colorbox{red}{\color{black}TRUE} null $p$-value to \textbf{move together} with the whole vector of $p$-values --- a small $p$-value never makes the others \textbf{more likely to be large} (\textit{positive regression dependency on a subset}, PRDS). \textbf{Positive correlation} is \textbf{not always enough}. With \textbf{negative} dependence, FDR control is \textbf{not guaranteed}

\par

\vspace{0.45em}

\settowidth{\hangindent}{$\textcolor{crukdark}{\bullet}$ }\hangafter=1 $\textcolor{crukdark}{\bullet}$ \colorbox{cruklight}{\color{white}Solution}: \textbf{BY}, which divides the threshold by $\sum_{j=1}^{n} 1/j$ and controls the FDR under \textbf{any} dependence (here $152 \rightarrow 75$ discoveries)

\par

\begin{tikzpicture}[remember picture, overlay]
\node[anchor=south west, inner sep=0, text width=341pt, align=left, font=\scriptsize, text=gray] at ([xshift=10.7pt,yshift=12.5pt]current page.south west) {Benjamini, Y. \& Yekutieli, D. \textit{The control of the false discovery rate in multiple testing under dependency}. Ann.\ Statist.\ \textbf{29}(4), 1165--1188 (2001).};
\end{tikzpicture}

## Controlling the FDR: Benjamini--Yekutieli (BY) {.t}

\vspace{-0.01em}

\begingroup

BH and BY are the \textbf{same} step-up rule --- order the $p$-values, take the \textbf{largest} $k$ such that

\par
\endgroup

\vspace{-5.6pt}

$$p_{(k)} \leq \frac{k\,q}{n\,c(n)} \qquad\qquad
\begin{array}{ll}
\textbf{BH:} & c(n) = 1\\[2pt]
\textbf{BY:} & c(n) = \sum\limits_{j=1}^{n} \dfrac{1}{j} \approx \ln n + 0.577
\end{array}$$

\vspace{-1.2pt}

\settowidth{\hangindent}{$\textcolor{crukdark}{\bullet}$ \colorbox{cruklight}{\color{white}Assumptions}: }\hangafter=1 $\textcolor{crukdark}{\bullet}$ \colorbox{cruklight}{\color{white}Assumptions}: \textbf{none} on the dependence of the $p$-values

\par

\vspace{0.45em}

\settowidth{\hangindent}{$\textcolor{crukdark}{\bullet}$ \colorbox{cruklight}{\color{white}The price}: }\hangafter=1 $\textcolor{crukdark}{\bullet}$ \colorbox{cruklight}{\color{white}The price}: $c(n) > 1$ makes the threshold $c(n)$ times \textbf{stricter at every rank} --- not $c(n)$ times fewer discoveries ($c(100) \approx 5.2$, $c(1000) \approx 7.5$, $c(10^4) \approx 9.8$)

\par

\vspace{0.45em}

\settowidth{\hangindent}{$\textcolor{crukdark}{\bullet}$ }\hangafter=1 $\textcolor{crukdark}{\bullet}$ In our $n = 1000$ example, at $q = 0.10$: BH rejects $152$ hypotheses, BY only $\mathbf{75}$

\par

\vspace{0.2em}

\begingroup\centering

\textbf{\large BY is the dependence-robust version of BH}

\par\endgroup

## Controlling the FDR: Storey's procedure {.t}

\vspace{-0.2em}

\textbf{\textcolor{crukdark}{Recover the power BH loses through the factor $\boldsymbol{m_0/n}$}}

\vspace{-0.3em}

\begingroup

\settowidth{\hangindent}{$\textcolor{crukdark}{\bullet}$ }\hangafter=1 $\textcolor{crukdark}{\bullet}$ BH is \textbf{calibrated} for the worst case $m_0 = n$: every hypothesis is a \colorbox{red}{\color{black}TRUE} null. Storey instead takes into account the proportion of true nulls $\pi_0 = m_0/n$

\vspace{0.45em}

\settowidth{\hangindent}{$\textcolor{crukdark}{\bullet}$ }\hangafter=1 $\textcolor{crukdark}{\bullet}$ $\pi_0$ is unknown, but it can be \textbf{estimated from the data}: $\hat{\pi}_0$

\vspace{0.45em}

\setlength{\abovedisplayskip}{4pt}\setlength{\belowdisplayskip}{4pt}\settowidth{\hangindent}{$\textcolor{crukdark}{\bullet}$ }\hangafter=1 $\textcolor{crukdark}{\bullet}$ Apply the \textbf{BH rule} with $q/\hat{\pi}_0$ in place of $q$: take the \textbf{largest} $k$ such that $$p_{(k)} \leq \frac{k\,q}{n\,\hat{\pi}_0} \qquad \text{and reject the } k \text{ smallest } p\text{-values}$$

\vspace{0.45em}

\settowidth{\hangindent}{$\textcolor{crukdark}{\bullet}$ }\hangafter=1 $\textcolor{crukdark}{\bullet}$ Since $\hat{\pi}_0 \leq 1$ (it is capped at 1), the threshold is \textbf{at least as large} as BH's: \textbf{more power}, and the more hypotheses are false ($\pi_0 \ll 1$), the larger the gain

\vspace{0.45em}

\settowidth{\hangindent}{$\textcolor{crukdark}{\bullet}$ \colorbox{cruklight}{\color{white}Assumptions}: }\hangafter=1 $\textcolor{crukdark}{\bullet}$ \colorbox{cruklight}{\color{white}Assumptions}: independence, or only \textbf{local} correlation (e.g. small groups of genes), plus a reliable $\hat{\pi}_0$ --- which needs \textbf{many} tests

\par
\endgroup
\begin{tikzpicture}[remember picture, overlay]
\node[anchor=south, inner sep=0, font=\small\bfseries, text=crukdark] at ([yshift=12pt]current page.south) {How $\boldsymbol{\hat{\pi}_0}$ is estimated: see the slides \textit{Storey's estimate of the FDR -- step by step}};
\end{tikzpicture}

## Controlling the FDR: which method? {.t}

\vspace{1.0em}

\begin{center}
\small
\renewcommand{\arraystretch}{1.5}
\setlength{\tabcolsep}{4pt}
\begin{tabular}{@{}l >{\raggedright\arraybackslash}p{4.15cm} >{\raggedright\arraybackslash}p{1.6cm} >{\raggedright\arraybackslash}p{3.95cm}@{}}
\hline
\textbf{Method} & \textbf{Assumptions} & \textbf{Power} & \textbf{Best used for} \\
\hline
\textbf{BH} & Independence or PRDS & Intermediate & Few true effects ($\pi_0 \approx 1$), or too few tests to estimate $\pi_0$ \\
\textbf{BY} & Any dependence & Lowest & Unknown or negative dependence \\
\textbf{Storey} & Independence or local correlation, plus a reliable $\hat{\pi}_0$ & Highest & Many tests, large fraction of true effects ($\pi_0 \ll 1$) \\
\hline
\end{tabular}
\normalsize
\end{center}

\vspace{0.4em}

\begin{center}
\textbf{All three order the $\boldsymbol{p}$-values and use a step-up threshold: they differ only\\ in the constant \emph{dividing} $\boldsymbol{k\,q/n}$: fixed (BH, BY) or \emph{estimated} (Storey)}
\end{center}

## Storey's estimate of the FDR: step by step {.t}

\vspace{0.15em}

\begingroup

The same $n = 1000$ \textbf{independent} tests: empirical distribution of the $p$-values, with $\alpha = 0.05$ used as a \textbf{fixed cut-off} and $\lambda = 0.5$ above which $p$-values are taken as \colorbox{red}{\color{black}TRUE} nulls

\par
\endgroup

\vspace{-0.6em}

```{r storey-hist, fig.width=6.4, fig.height=2.58, fig.align="center", out.width="92%"}
crukdark  <- "#00007E"
cruklight <- "#009CEE"
crukpink  <- "#FF0087"

## Simulated example: 1000 tests, 800 true nulls and 200 real effects.
## True nulls give Uniform(0,1) p-values; real effects (z shifted by 3)
## give p-values piled up near 0. In practice only the mixture is seen.
set.seed(7)
n_st  <- 1000
m1_st <- 200
m0_st <- n_st - m1_st
p_st  <- c(runif(m0_st), 2 * pnorm(-abs(rnorm(m1_st, mean = 3))))
t_st  <- 0.05

par(mar = c(2.9, 4.2, 0.6, 0.8), mgp = c(1.9, 0.6, 0))
h <- hist(p_st, breaks = seq(0, 1, by = 0.05), plot = FALSE)
plot(h, freq = TRUE, col = cruklight, border = "white", main = "",
     xlab = expression(italic(p) * "-value"), ylab = expression("Number of " * italic(p) * "-values"),
     cex.lab = 1.15, cex.axis = 0.95, las = 1, xaxt = "n")
axis(1, at = seq(0, 1, 0.1), cex.axis = 0.95)
ymx <- max(h$counts)                      # = R, the first bar

## the significance threshold
abline(v = t_st, col = crukpink, lwd = 2.6)
text(t_st, ymx * 0.97, expression(alpha == 0.05),
     col = crukpink, pos = 4, cex = 1.15, font = 2)

## R = observed rejections: the first bar, all p-values <= alpha
R_st <- sum(p_st <= t_st)
arrows(0.085, ymx * 0.74, 0.025, ymx * 0.74, length = 0.07, lwd = 2,
       col = crukdark)
text(0.083, ymx * 0.74, bquote(italic(R) == .(R_st)),
     col = crukdark, pos = 4, cex = 1.15)
text(0.083, ymx * 0.64, "observed rejections",
     col = crukpink, pos = 4, cex = 1.15, font = 3)

## number of p-values above lambda = 0.5, marked with a bracket
W_st <- sum(p_st > 0.5)
hbrace <- function(x0, x1, y, h, ...) {
  xm <- (x0 + x1) / 2; q <- (x1 - x0) * 0.08
  xspline(c(x0, x0 + q, xm - q, xm, xm + q, x1 - q, x1),
          c(y, y + h / 2, y + h / 2, y + h, y + h / 2, y + h / 2, y),
          shape = c(0, 1, 1, 0, 1, 1, 0), open = TRUE, ...)
}
hbrace(0.5, 1, ymx * 0.28, ymx * 0.065, border = crukdark, lwd = 2)
text(0.75, ymx * 0.49, bquote(.(W_st) ~ italic(p) * "-values" > lambda ~ "=" ~ 0.5),
     col = crukdark, cex = 1.15)

## second line: "(mostly TRUE nulls)", TRUE in a red box as on earlier slides
lab_cex <- 1.05; y2 <- ymx * 0.395
pieces  <- c("(mostly", " TRUE ", " nulls)")
wd <- strwidth(pieces, cex = lab_cex)
x0 <- 0.75 - sum(wd) / 2
xs <- x0 + c(0, cumsum(wd)[-length(wd)])
ht <- strheight("TRUE", cex = lab_cex)
rect(xs[2] + 0.004, y2 - ht, xs[2] + wd[2] - 0.004, y2 + ht,
     col = "red", border = NA)
text(xs, y2, pieces, adj = c(0, 0.5), cex = lab_cex,
     col = c(crukdark, "black", crukdark))

## arrow up from the count to pi0-hat, the proportion of TRUE nulls
pi0_st <- W_st / (n_st * 0.5)
arrows(0.83, ymx * 0.565, 0.83, ymx * 0.775, length = 0.09, lwd = 2,
       col = crukdark)
text(0.97, ymx * 0.97,
     bquote(hat("\u03C0")[0] == .(W_st) / (.(n_st) %*% (1 - lambda)) ~ "=" ~ .(sprintf("%.3f", pi0_st))),
     col = crukdark, cex = 1.15, adj = c(1, 0.5))
text(0.97, ymx * 0.87, "estimated proportion of true null hypotheses",
     col = crukpink, cex = 1.15, font = 3, adj = c(1, 0.5))
```

\vspace{-1.1em}

$$\widehat{\mathrm{FDR}}(\alpha) = \frac{\hat{\pi}_0 \times n \times \alpha}{R} = \frac{`r sprintf("%.3f", pi0_st)` \times `r n_st` \times `r t_st`}{`r R_st`} = \textcolor{crukdark}{\mathbf{`r sprintf("%.3f", pi0_st * n_st * t_st / max(R_st, 1))`}}$$

\vspace{-0.4em}

\begingroup\scriptsize\textcolor{gray}{Storey, J.\,D. \textit{A direct approach to false discovery rates}. J.\ R.\ Stat.\ Soc.\ B \textbf{64}(3), 479--498 (2002).}

\par\endgroup

## Storey's estimate of the FDR: step by step {.t}

\vspace{0.15em}

\settowidth{\hangindent}{$\textcolor{crukdark}{\bullet}$ }\hangafter=1 $\textcolor{crukdark}{\bullet}$ \colorbox{cruklight}{\color{white}Conservative}: $\hat{\pi}_0$ treats every $p$-value above $\lambda$ as coming from a \colorbox{red}{\color{black}TRUE} null. Some real effects also land there, so $\hat{\pi}_0$ is biased \textbf{upwards} and $\widehat{\mathrm{FDR}}$ errs on the \textbf{safe} side (too high, never too low on average)

\par

\vspace{0.3em}

\settowidth{\hangindent}{$\textcolor{crukdark}{\bullet}$ }\hangafter=1 $\textcolor{crukdark}{\bullet}$ The bias \textbf{shrinks} when power is high or $\lambda$ is large; but a larger $\lambda$ leaves fewer $p$-values to count, so the estimate is \textbf{noisier} ($\lambda = 0.5$ is the usual compromise)

\par

\vspace{0.6em}

\settowidth{\hangindent}{$\textcolor{crukdark}{\bullet}$ }\hangafter=1 $\textcolor{crukdark}{\bullet}$ \colorbox{cruklight}{\color{white}Without independence}: each null $p$-value is still Uniform$(0,1)$, but correlated $p$-values move \textbf{together}: in a single study their histogram can be far from uniform, so $\hat{\pi}_0$ and $\widehat{\mathrm{FDR}}$ can be far from the truth, \textbf{too high or too low}

\par

\vspace{0.6em}

\settowidth{\hangindent}{$\textcolor{crukdark}{\bullet}$ }\hangafter=1 $\textcolor{crukdark}{\bullet}$ \colorbox{cruklight}{\color{white}Solution}: \textbf{resample} so that the correlation between tests is kept, e.g. by permuting the sample labels (Storey's permutation method)

\par

\begin{tikzpicture}[remember picture, overlay]
\node[anchor=south west, inner sep=0, text width=341pt, align=left, font=\scriptsize, text=gray] at ([xshift=10.7pt,yshift=12.5pt]current page.south west) {Storey, J.\,D. \& Tibshirani, R. \textit{Estimating the positive false discovery rate under dependence, with applications to DNA microarrays}. Technical Report No.\ 2001-28, Department of Statistics, Stanford University (2001).};
\end{tikzpicture}

## FDR-adjusted $p$-values: the $q$-value {.t}

\vspace{-1pt}

\hangindent=9pt\\hangafter=1 $\textcolor{crukdark}{\bullet}$ \colorbox{cruklight}{\color{white}Definition}: the \textbf{smallest FDR} at which a test would still be called significant. Note: $q_{(i)}$ is the \textbf{$\boldsymbol{q}$-value of one test}, not the FDR \textbf{level} $q$

\vspace{0.8em}

\hangindent=9pt\\hangafter=1 $\textcolor{crukdark}{\bullet}$ \colorbox{cruklight}{\color{white}Calculation of $q$-values}: for the ordered $p$-values $p_{(1)} \leq \dots \leq p_{(n)}$

\vspace{0.3em}

\begingroup\centering
\renewcommand{\arraystretch}{1.5}
\setlength{\tabcolsep}{2pt}
\small
\begin{tabular}{@{}ccc@{}}
\hline
\textbf{BH} & \textbf{BY} & \textbf{Storey} \\
\hline
$\displaystyle \min_{j \,\geq\, i} \min\!\left(1, \frac{n}{j}\,p_{(j)}\right)$ &
$\displaystyle \min_{j \,\geq\, i} \min\!\left(1, c(n)\,\frac{n}{j}\,p_{(j)}\right)$ &
$\displaystyle \min_{j \,\geq\, i} \min\!\left(1, \hat{\pi}_0\,\frac{n}{j}\,p_{(j)}\right)$ \\
\hline
\end{tabular}\par
\normalsize
\vspace{0.5em}

\footnotesize Same three steps: scale $p_{(j)}$ by $n/j$, take the \textbf{running minimum from the right}, cap at $1$

\par
\vspace{0.15em}

Only the constant in front differs: $1$ (BH), $c(n) = \sum_{j=1}^{n} 1/j$ (BY), $\hat{\pi}_0$ (Storey)

\par
\endgroup

\vspace{0.6em}

\hangindent=9pt\\hangafter=1 $\textcolor{crukdark}{\bullet}$ \colorbox{cruklight}{\color{white}Interpretation}: reject every test with $q_{(i)} \leq 0.05$ and \textbf{at most} $\approx 5\%$ of those discoveries are expected to be false

\begin{tikzpicture}[remember picture, overlay]
\node[anchor=south west, inner sep=0, text width=341pt, align=left, font=\scriptsize, text=gray] at ([xshift=10.7pt,yshift=12.5pt]current page.south west) {Storey, J.\,D. \textit{The positive false discovery rate: a Bayesian interpretation and the $q$-value}. Ann.\ Statist.\ \textbf{31}(6), 2013--2035 (2003). \quad Storey, J.\,D. \& Tibshirani, R. \textit{Statistical significance for genomewide studies}. Proc.\ Natl.\ Acad.\ Sci.\ USA \textbf{100}(16), 9440--9445 (2003).};
\end{tikzpicture}

## Reading a $q$-value off the plot {.t}

\vspace{-0.01em}

\begingroup

The line from the \textbf{origin} through a point has slope $p_{(i)}/i$: it is the BH threshold line at the level $q = n\,p_{(i)}/i$. The \textbf{same} point gives \textbf{three} adjusted values, one per constant

\par
\endgroup

\vspace{-0.9em}

```{r padj-plot, fig.width=6.8, fig.height=1.72, fig.align="center", out.width="86%"}
crukdark  <- "#00007E"
crukpink  <- "#FF0087"

## same simulated data as the previous BH slides
set.seed(7)
n_pa  <- 1000
p_pa  <- c(runif(800), 2 * pnorm(-abs(rnorm(200, mean = 3))))
q_pa  <- 0.10
ps_pa <- sort(p_pa)
k_pa  <- max(which(ps_pa <= seq_len(n_pa) * q_pa / n_pa))
xmax_pa <- 250

par(mar = c(2.9, 4.2, 0.5, 0.8), mgp = c(2.2, 0.55, 0))
plot(NULL, xlim = c(0, xmax_pa), ylim = c(0, 0.032), bty = "n", las = 1,
     xlab = "", ylab = "", cex.axis = 0.9)
mtext(expression("rank " * italic(i) * " of the ordered " * italic(p) * "-values"),
      side = 1, line = 1.8, cex = 1.0)
mtext(expression(italic(p) * "-value"), side = 2, line = 2.9, cex = 1.0)

abline(0, q_pa / n_pa, col = crukpink, lwd = 2.4)
text(xmax_pa, xmax_pa * q_pa / n_pa + 0.0028,
     expression(italic(i) * italic(q) / italic(n)), col = crukpink, cex = 1.05,
     font = 2, adj = c(1, 0.5), xpd = NA)

sel <- 1:xmax_pa
points(sel, ps_pa[sel], pch = 19, cex = 0.45,
       col = ifelse(sel <= k_pa, crukdark, "grey65"))

## the line from the origin through the point of rank 152
i_ex <- k_pa
segments(0, 0, i_ex, ps_pa[i_ex], col = crukdark, lwd = 1.8, lty = 2)
points(i_ex, ps_pa[i_ex], pch = 21, bg = "white", col = crukdark, lwd = 2, cex = 1.2)
text(i_ex + 7, ps_pa[i_ex] - 0.0028,
     bquote(italic(p)[(152)] == .(sprintf("%.5f", ps_pa[i_ex]))),
     col = crukdark, cex = 1.0, font = 2, adj = c(0, 0.5), xpd = NA)

## same arrow and labels as the BH slide
arrows(124, 0.0215, i_ex - 4, ps_pa[i_ex] + 0.0013, length = 0.07,
       lwd = 1.8, col = crukdark)
text(60, 0.0310, bquote(italic(k) == .(i_ex)),
     col = crukdark, cex = 1.0, adj = c(0, 0.5), xpd = NA)
text(60, 0.0240, bquote("reject ranks 1 to" ~ italic(k)),
     col = crukpink, cex = 1.0, font = 3, adj = c(0, 0.5), xpd = NA)
```

\vspace{-1.0em}

\begingroup\centering\footnotesize

$q_{\mathrm{BH}} = \dfrac{n \times p_{(152)}}{152} = \dfrac{1000 \times 0.01488}{152} = 0.098$

\par
\vspace{0.1em}

\begingroup\scriptsize here the running minimum is reached at $j = 152$, and nothing is capped at $1$

\par\endgroup
\footnotesize
\vspace{0.2em}
\renewcommand{\arraystretch}{1.15}
\setlength{\tabcolsep}{9pt}
\begin{tabular}{@{}ccc@{}}
\hline
\textbf{BH} & \textbf{BY} & \textbf{Storey} \\
$1 \times 0.098$ & $7.49 \times 0.098$ & $0.796 \times 0.098$ \\
$\boldsymbol{0.098}$ & $\boldsymbol{0.733}$ & $\boldsymbol{0.078}$ \\
\hline
\end{tabular}\par
\endgroup
\begin{tikzpicture}[remember picture, overlay]
\node[anchor=south, inner sep=0, font=\small\bfseries, text=crukdark] at ([yshift=12pt]current page.south) {At $q = 0.10$ the same test is \textbf{rejected} by BH and Storey, \textbf{not} by BY};
\end{tikzpicture}

