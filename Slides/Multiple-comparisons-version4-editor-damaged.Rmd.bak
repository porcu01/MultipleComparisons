\vspace{-1pt}

\noindent\hspace\*{14.5pt}\\tikz[baseline=-0.55ex, overlay]{\\draw[-{Latex[length=5pt,width=4pt]}, thick, crukdark] (0,9.5pt) -- (0,0) -- (16pt,0);}\\hspace{20pt}\\textbf{\\textcolor{crukdark}{The max-\$t\$ principle is applied to \$\\mathcal{D}\$}}

\par

\vspace{0.3em}

\begingroup\small\noindent\setlength{\fboxsep}{3.5pt}\fcolorbox{crukpink}{white}{\parbox{\dimexpr\linewidth-2\fboxsep-2\fboxrule\relax}{\centerline{\textbf{\textcolor{crukdark}{T2}}, \textbf{\textcolor{crukdark}{T3}} and \textbf{\textcolor{crukdark}{Games--Howell}} treat $\mathcal{D}$ \textbf{marginally} (each statistic on its own)}}}

\par\endgroup

## Dunnett-type test without normality (Steel) {.t}

\vspace{-1pt}

$\textcolor{crukdark}{\bullet}$ \colorbox{cruklight}{\color{white}Statistical model}: one-way layout \textbf{without} the normality assumption

\vspace{-1.2em}

```{r steel-nonormal, fig.width=6.8, fig.height=1.60, fig.align="center", out.width="92%"}
crukdark <- "#00007E"; cruklight <- "#009CEE"; crukpink <- "#FF0087"

## skewed, non-normal shapes: the same distribution shifted in location
sh <- 2.6; sc <- 0.55
mus  <- c(0, 2.6, 4.4, 7.4)
labs <- list(expression("Control " * F[0]), expression("Arm 1 " * F[1]),
             expression("Arm 2 " * F[2]), expression("Arm " * italic(n) * " " * F[italic(n)]))
cols <- c(crukpink, cruklight, cruklight, cruklight)
ytop <- dgamma((sh - 1) * sc, shape = sh, scale = sc)

par(mar = c(1.4, 0.3, 0.2, 0.3))
plot(NULL, xlim = c(-1.6, 14.6), ylim = c(0, ytop * 1.08),
     axes = FALSE, xlab = "", ylab = "")
segments(-1.6, 0, 9.2, 0, col = "grey40", lwd = 1)
for (k in seq_along(mus)) {
  xs <- seq(mus[k], mus[k] + 4.4, length.out = 300)
  ds <- dgamma(xs - mus[k], shape = sh, scale = sc)
  polygon(c(xs, rev(xs)), c(ds, rep(0, length(xs))),
          col = adjustcolor(cols[k], 0.18), border = NA)
  lines(xs, ds, col = cols[k], lwd = 2)
  mtext(labs[[k]], side = 1, line = 0.25, at = mus[k] + (sh - 1) * sc,
        cex = 0.78, col = cols[k])
}
text(6.4, ytop * 0.25, expression(cdots), cex = 1.4, col = crukdark)

box_stack <- function(txts, cx = 0.95) {
  bw  <- max(sapply(txts, strwidth, cex = cx)) * 1.12
  bh  <- max(sapply(txts, strheight, cex = cx)) * 1.5
  gap <- bh * 0.18
  x   <- par("usr")[2] - bw/2
  ys  <- par("usr")[4] - bh/2 - (seq_along(txts) - 1) * (bh + gap)
  par(xpd = NA)
  for (i in seq_along(txts)) {
    rect(x - bw/2, ys[i] - bh/2, x + bw/2, ys[i] + bh/2,
         border = crukdark, lwd = 1.3, col = "white")
    text(x, ys[i], txts[[i]], cex = cx, col = crukdark, font = 2)
  }
}

box_stack(list(
  expression(bold("No normality: ") * F[k] * " any continuous distribution"),
  expression(bold("Independence: ") * Y[ki] * " mutually independent")))
```

\vspace{-1.3em}

\settowidth{\hangindent}{$\textcolor{crukdark}{\bullet}$ \colorbox{cruklight}{\color{white}Hypotheses}: }\hangafter=1 $\textcolor{crukdark}{\bullet}$ \colorbox{cruklight}{\color{white}Hypotheses}: $H_k : F_k = F_0$, $k = 1, \dots, n$\vspace{3.5pt}\newline {\fontsize{10.5pt}{12.5pt}\selectfont For each of the $n$ arms, the arm distribution equals the control distribution $F_0$

\par

}

\vspace{0.25em}

\settowidth{\hangindent}{$\textcolor{crukdark}{\bullet}$ }\hangafter=1 $\textcolor{crukdark}{\bullet}$ Each $t_k$ (standardised Wilcoxon rank sum) is \textbf{asymptotically} standard normal under $H_k$\newline \colorbox{cruklight}{\color{white}$\mathcal{D}$} is \textbf{asymptotically} a multivariate normal distribution under $H_0^{\mathrm{global}}$

\vspace{-1pt}

\noindent\hspace\*{14.5pt}\\tikz[baseline=-0.55ex, overlay]{\\draw[-{Latex[length=5pt,width=4pt]}, thick, crukdark] (0,9.5pt) -- (0,0) -- (16pt,0);}\\hspace{20pt}\\textbf{\\textcolor{crukdark}{The max-\$t\$ principle is applied to \$\\mathcal{D}\$}}

\par

\vspace{\dimexpr0.3em+0pt\relax}

\begingroup\small\noindent\setlength{\fboxsep}{3.5pt}\fcolorbox{crukpink}{white}{\parbox{\dimexpr\linewidth-2\fboxsep-2\fboxrule\relax}{\centerline{\textbf{\textcolor{crukdark}{Šidák}} treats $\mathcal{D}$ \textbf{marginally} (each statistic on its own, not jointly)}}}

\par\endgroup

