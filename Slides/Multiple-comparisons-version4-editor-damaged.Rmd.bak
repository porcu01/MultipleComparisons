\settowidth{\hangindent}{$\textcolor{crukdark}{\bullet}$ \colorbox{cruklight}{\color{white}Hypotheses}: }\hangafter=1 $\textcolor{crukdark}{\bullet}$ \colorbox{cruklight}{\color{white}Hypotheses}: $H_{j\ell} : F_j = F_\ell$, $1 \leq j < \ell \leq k$\vspace{3.5pt}\newline {\fontsize{10.5pt}{12.5pt}\selectfont For each of the $n = k(k-1)/2$ pairs, the two group distributions are equal

\par

}

\vspace{0.25em}

\settowidth{\hangindent}{$\textcolor{crukdark}{\bullet}$ }\hangafter=1 $\textcolor{crukdark}{\bullet}$ Each $t_{j\ell}$ (standardised Wilcoxon rank sum) is \textbf{asymptotically} standard normal under $H_{j\ell}$\newline \colorbox{cruklight}{\color{white}$\mathcal{D}$} is \textbf{asymptotically} a multivariate normal distribution under $H_0^{\mathrm{global}}$

\vspace{-1pt}

\noindent\hspace\*{14.5pt}\\tikz[baseline=-0.55ex, overlay]{\\draw[-{Latex[length=5pt,width=4pt]}, thick, crukdark] (0,9.5pt) -- (0,0) -- (16pt,0);}\\hspace{20pt}\\textbf{\\textcolor{crukdark}{The max-\$t\$ principle is applied to \$\\mathcal{D}\$}}

\par

\vspace{\dimexpr0.3em+0pt\relax}

\begingroup\small\noindent\setlength{\fboxsep}{3.5pt}\fcolorbox{crukpink}{white}{\parbox{\dimexpr\linewidth-2\fboxsep-2\fboxrule\relax}{\centerline{\textbf{\textcolor{crukdark}{Šidák}} treats $\mathcal{D}$ \textbf{marginally} (each statistic on its own, not jointly)}}}

\par\endgroup

## Dunn's test (not a max-$t$ procedure) {.t}

\vspace{-1pt}

$\textcolor{crukdark}{\bullet}$ \colorbox{cruklight}{\color{white}Statistical model}: one-way layout \textbf{without} the normality assumption

\vspace{-1.2em}

```{r dunn-nonormal, fig.width=6.8, fig.height=1.05, fig.align="center", out.width="80%"}
crukdark <- "#00007E"; cruklight <- "#009CEE"; crukpink <- "#FF0087"

## skewed, non-normal shapes: the same distribution shifted in location
